# ==============================================================
# HEG Docker 环境变量配置
# 使用方法: 复制本文件为 .env，填入实际值后执行 docker compose up -d
# 每一项均与 src/main/resources/application.yml 中的 ${变量名:默认值} 一一对应
# ==============================================================

# ---------- 服务端口 ----------
# 宿主机映射端口(容器内部固定监听 9000)
HEG_SERVER_PORT=9000

# ---------- 云端连接 ----------
HEG_WEBSOCKET_URL=wss://api.hiasoon.com/ws
HEG_APP_ID=your-app-id
HEG_SECRET_KEY=your-secret-key
HEG_API_BASE_URL=https://api.hiasoon.com

# ---------- 运行时配置存储 ----------
# memory: 内存型，热更新配置重启后丢失
# file:   文件型，热更新配置持久化到 HEG_CONFIG_FILE_PATH
# 注意: 使用 file 模式时，文件中已保存的值会覆盖本文件中的云端/数据源配置
HEG_CONFIG_PERSISTENCE_TYPE=file
HEG_CONFIG_FILE_PATH=/app/data/heg-runtime-config.yml

# ---------- 应用运行日志 (logback，按天滚动拆分) ----------
# 修改后需同步修改 docker-compose.yml 中 volumes 的容器内挂载路径
HEG_LOG_PATH=/app/logs
HEG_LOG_LEVEL=INFO

# ---------- 业务操作日志 (SQL/Proxy 明细) 持久化 ----------
HEG_LOG_PERSISTENCE_ENABLED=false
HEG_SQL_LOG_PATH=/app/logs/sql/
HEG_PROXY_LOG_PATH=/app/logs/proxy/
HEG_LOG_MAX_FILE_SIZE_MB=100
# 日志保留天数(同时作用于应用日志和业务操作日志)
HEG_LOG_RETAIN_DAYS=30

# ---------- 透传请求头 (逗号分隔，请勿加空格；只有列表中的请求头会转发到氦闪平台) ----------
HEG_PROXY_HEADERS=X-Custom-Header,X-Request-Id,X-User-Id

# ---------- MySQL 数据源 ----------
# URL 留空则该数据源不启用；APP_ID 留空则自动使用 HEG_APP_ID
HEG_MYSQL_APP_ID=
HEG_MYSQL_URL=jdbc:mysql://localhost:3306/test?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
HEG_MYSQL_USERNAME=root
HEG_MYSQL_PASSWORD=your-password
HEG_MYSQL_INITIAL_SIZE=5
HEG_MYSQL_MAX_ACTIVE=20

# ---------- Redis 数据源 ----------
# HOST 留空则该数据源不启用；APP_ID 留空则自动使用 HEG_APP_ID
HEG_REDIS_APP_ID=
HEG_REDIS_HOST=
HEG_REDIS_PORT=6379
HEG_REDIS_PASSWORD=
HEG_REDIS_DATABASE=0

# ---------- MongoDB 数据源 ----------
# URI 留空则该数据源不启用；APP_ID 留空则自动使用 HEG_APP_ID
HEG_MONGO_APP_ID=
HEG_MONGO_URI=
HEG_MONGO_DATABASE=

# ---------- JVM 参数 ----------
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
